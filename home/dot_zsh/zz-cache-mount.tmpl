{{ if eq .class "work-devbox" -}}
# cache-mount: warn at interactive shell startup while /mnt/cache (the EBS Bazel build
# cache) is unmounted, so a cold cache does not silently slow every build. The message
# comes from ~/.local/state/cache-mount/STATUS, written by ensure-cache-mount.sh.
#
# Under Orca, panes run Claude fullscreen and hide this; the devbox-status SessionStart
# hook carries the same warning there.
#
# work-devbox only (renders empty -> not deployed elsewhere).
() {
    mountpoint -q /mnt/cache && return 0
    local status_file="$HOME/.local/state/cache-mount/STATUS"
    local msg="${$(tail -n1 "$status_file" 2>/dev/null)#* }"   # strip leading timestamp
    print -P "%F{red}%B⚠ cache mount:%b%f %F{red}${msg:-/mnt/cache not mounted; run: devbox-up}%f"
}
{{- end }}
