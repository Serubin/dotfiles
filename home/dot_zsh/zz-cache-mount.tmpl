{{ if eq .class "work-devbox" -}}
# cache-mount: warn at interactive shell startup if the per-connection mount of
# /mnt/cache (the EBS Bazel build cache) failed or was skipped with Ctrl-C, so a cold
# cache does not silently slow every build. ~/.local/bin/ensure-cache-mount.sh writes
# ~/.local/state/cache-mount/STATUS in both cases and clears it on the next success.
#
# This banner is the ONLY way that failure becomes visible: the helper runs from
# tmux-devel.sh just before `exec tmux -CC`, and tmux switches the pty into control
# mode immediately after, discarding anything printed there.
#
# work-devbox only (renders empty -> not deployed elsewhere).
() {
    local status_file="$HOME/.local/state/cache-mount/STATUS"
    [[ -f "$status_file" ]] || return 0
    # Only nag on a recent failure (< 24h) so a stale marker stays quiet.
    [[ -n "$(find "$status_file" -mmin -1440 2>/dev/null)" ]] || return 0
    local msg="${$(tail -n1 "$status_file" 2>/dev/null)#* }"   # strip leading timestamp
    print -P "%F{red}%B⚠ cache mount:%b%f %F{red}${msg:-/mnt/cache not mounted; run: mount-cache-dir}%f"
}
{{- end }}
