# Aliases
#

# cd
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."


# ls aliases
{{ if eq .chezmoi.os "darwin" -}}
alias ls="gls --color=auto"
alias sed="gsed"
alias dircolors="gdircolors"
{{- else -}}
alias ls="ls --color=auto -N"
{{- end }}

alias la="ls -A"
alias ll="ls -lhAr"

# BSD grep takes --color=auto too, so this needs no darwin/ggrep branch.
alias grep="grep --color=auto"

# shortcuts
alias _="sudo"
alias g="git"
alias cm="chezmoi"
alias v="vim"
alias rr="rm -r"
alias sudo="sudo "
# ip aliases
alias ipdns="dig +short myip.opendns.com @resolver1.opendns.com"
alias ipl="ifconfig | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1'"
alias "#"="echo #"

# vim
alias vim="nvim"
alias vi="vim"

{{ if ne .chezmoi.os "darwin" -}}
alias open="xdg-open &> /dev/null"
{{ end -}}

# listing cd
alias cd="cdls"
alias cd..="cd .."
alias cd.="cd ."

# Named directories, for reaching these checkouts quickly. Better than `cdfoo` aliases:
# the name is a path *prefix*, so `cd ~dotfiles/home` works, and `~dot<TAB>` completes.
# They do not change how the prompt renders -- it shows the real path on purpose, see
# prompt_pwd in prompt/prompt-theme. Tildes expand to absolute paths at definition time.
hash -d dotfiles=~/.dotfiles
{{ if eq .environment "work" -}}
hash -d services=~/lwcode/services/vulnerability
hash -d athena=~/lwcode/athena
hash -d athena-eval=~/lwcode/athena/vuln-eval
hash -d athena-redis=~/lwcode/athena/athena-redis-db
hash -d helm3=~/lwcode/helm3-platform
{{ end }}
alias py="python"

alias extract="aunpack"

# Manually snapshot tmux session state via tmux-resurrect (on top of the cron
# periodic save + client-detached hook). Unconditional — unlike the cron wrapper.
alias tmux-save='$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh quiet && echo "✓ tmux session saved"'

bindkey '^R' history-incremental-search-backward

function tabname() {
  if [ -z "$TMUX" ] ; then
    printf "\e]1;%s\a" "$*"
  else
    tmux rename-window "$*"
  fi
}
