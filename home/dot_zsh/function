# Helpful functions
#

# Create a new directory and enter it

mk() {
    mkdir -p "$@" && cd "$@"
}


# Automatically calls ls after moving to new directory
function cdls()
{
  if [ $# -eq 0 ]; then # if no arguments
    \cd && ls
  else # if arguments
    \cd "$@" && ls
  fi
}

# Cache a CLI completion to a file, regenerate when binary changes
_cache_completion() {
  local cmd="$1"
  local cache_dir="${HOME}/.zsh/cache"
  local cache_file="${cache_dir}/${cmd}.zsh"
  local bin_path="$(command -v $cmd 2>/dev/null)"

  [ -z "$bin_path" ] && return

  # Guarded: coreutils' mkdir is a ~7ms fork, and this runs on every startup for every
  # cached completion even though the directory almost always exists already.
  [ -d "$cache_dir" ] || mkdir -p "$cache_dir"
  if [ ! -f "$cache_file" ] || [ "$bin_path" -nt "$cache_file" ]; then
    $cmd completion zsh > "$cache_file" 2>/dev/null
  fi
  source "$cache_file"
}

# Defer sourcing nvm.sh until the first nvm/node/npm/npx call. Call from ~/.custom;
# --auto-use also switches node version on entering a directory with .nvmrc.
#
#   export NVM_DIR="$HOME/.nvm"
#   lazy_load_nvm            # basic lazy loading
#   lazy_load_nvm --auto-use # also auto-switch on .nvmrc
lazy_load_nvm() {
  local auto_use=false
  [[ "$1" == "--auto-use" ]] && auto_use=true

  _nvm_lazy_load() {
    unfunction nvm node npm npx 2>/dev/null
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
    [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \
      . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
  }

  nvm()  { _nvm_lazy_load; nvm "$@"; }
  node() { _nvm_lazy_load; node "$@"; }
  npm()  { _nvm_lazy_load; npm "$@"; }
  npx()  { _nvm_lazy_load; npx "$@"; }

  if $auto_use; then
    load-nvmrc() {
      local nvmrc_path
      nvmrc_path="$(command -v nvm_find_nvmrc > /dev/null 2>&1 && nvm_find_nvmrc)"
      if [ -z "$nvmrc_path" ]; then
        if [ -f ".nvmrc" ]; then
          _nvm_lazy_load
          load-nvmrc
        fi
        return
      fi
      local node_version="$(nvm version)"
      if [ -n "$nvmrc_path" ]; then
        local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")
        if [ "$nvmrc_node_version" = "N/A" ]; then
          nvm install
        elif [ "$nvmrc_node_version" != "$node_version" ]; then
          nvm use
        fi
      elif [ "$node_version" != "$(nvm version default)" ]; then
        echo "Reverting to nvm default version"
        nvm use default
      fi
    }
    autoload -U add-zsh-hook
    add-zsh-hook chpwd load-nvmrc
  fi
}

# Route `claude` to a per-account config dir, and default to bypassing permissions.
# `--work` / `--personal` are consumed here so everything after them still reaches the
# real CLI; the default account comes from CLAUDE_CONFIG_DIR (set in ~/.zsh/zz-env).
claude() {
  local arg cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude-personal} ddash=0
  local -a args perms

  for arg in "$@"; do
    # Past a literal `--`, a bare `--work` is the caller's data, not our flag.
    if (( ddash )); then args+=("$arg"); continue; fi
    case $arg in
      --)         ddash=1; args+=("$arg") ;;
      --work)     cfg=$HOME/.claude-work ;;
      --personal) cfg=$HOME/.claude-personal ;;
      *)          args+=("$arg") ;;
    esac
  done

  # Subcommands (`claude mcp list`) reject --dangerously-skip-permissions, and a permission
  # flag the caller passed is them opting out. Subcommands are inferred rather than listed,
  # since the list grows with each release: one is always a single bare word, where a
  # session's first argument is absent, a flag, or a multi-word prompt. Misreading a
  # one-word prompt only loses the default; the reverse would be a hard error.
  if (( ! ${args[(I)(--dangerously-skip-permissions|--permission-mode|--permission-mode=*)]} )) &&
     [[ -z ${args[1]} || ${args[1]} == -* || ${args[1]} == *[[:space:]]* ]]
  then
    perms=(--dangerously-skip-permissions)
  fi

  CLAUDE_CONFIG_DIR=$cfg command claude "${perms[@]}" "${args[@]}"
}
