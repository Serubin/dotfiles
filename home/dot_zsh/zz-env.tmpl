# Per-machine shell config, resolved at apply time by chezmoi (no runtime detection).
# Sourced LAST by ~/.zshrc's `~/.zsh/*` loop — the `zz-` prefix sorts after
# alias/env/function/promptrc — so it can override anything set earlier.
#
# Machine-ROLE config, committed. Machine-LOCAL overrides and secrets go in ~/.custom
# instead (sourced afterward, untracked).
#
# environment={{ .environment }}  class={{ .class }}
export DOTFILES_ENV={{ .environment | quote }}
export DOTFILES_CLASS={{ .class | quote }}

# Claude Code keys its whole identity -- auth, .claude.json, projects, history -- off this
# one variable, so two logins mean two dirs. Exported rather than set inside the `claude`
# wrapper (~/.zsh/function) so scripts and editors launched from this shell resolve the
# same account; the wrapper's --work/--personal overrides it for a single invocation.
export CLAUDE_CONFIG_DIR="$HOME/.claude-{{ .environment }}"

{{ if eq .class "work-mac" -}}
# ===== work-mac =====
{{ else if eq .class "work-devbox" -}}
# ===== work-devbox =====
{{ else if eq .class "personal-mac" -}}
# ===== personal-mac =====
{{ else if eq .class "personal-server" -}}
# ===== personal-server =====
{{ else -}}
# ===== {{ .class }} =====  (custom or other class)
{{ end -}}
