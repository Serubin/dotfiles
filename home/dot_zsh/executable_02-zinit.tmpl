#!/bin/zsh

ZINIT_HOME="${HOME}/.zsh/zinit"
source "${ZINIT_HOME}/zinit.zsh"

zinit light zsh-users/zsh-syntax-highlighting

# deja: predictive ghost-text autosuggestions, replacing zsh-autosuggestions.
# Binary installed by run_once_before_20-install-packages (brew on macOS, upstream's
# prebuilt release into ~/.local/bin on Debian — no brew needed). deja wraps
# ZLE widgets — Right/End accept the full suggestion, Ctrl+Right accepts a word
# (the widgets autosuggestions also hooked) — and re-asserts on every precmd, so
# load order is irrelevant. Shift+Tab cycles alternative suggestions. Two of deja's
# default keybindings are disabled so they don't clobber ours each prompt: Tab
# (keep completion) and ^X (keep ^X^E, see env).
#
# Pinned to ~/.local/bin/deja rather than whatever `deja` resolves to on PATH — on macOS
# that build carries local changes not yet in a brew release, and it is also where the
# Debian install lands. Drop the pin for a bare `deja` once those changes ship.
# `deja init zsh` writes ~/.local/share/deja/init.zsh and then prints nothing but a `source`
# line for it (cmd/deja/init.go), so the documented `eval "$(deja init zsh)"` spends ~36ms
# launching a 12MB binary to regenerate a file it already wrote. Source that file directly
# instead, but only while it still matches the binary it was generated from: init.zsh *is* the
# binary's embedded internal/shell/zsh.sh with its DEJA_BIN and DEJA_SOCK placeholders
# substituted, so a mismatched pair can disagree about the variables they share.
#
# The freshness test is a stat fingerprint rather than `deja version`, for two reasons:
#
#   - `deja version` costs 27-40ms, which is the entire saving this cache exists to make.
#     `zstat` is a zsh builtin, so the fingerprint costs ~0.007ms.
#   - It wouldn't work anyway. cmd/deja/main.go hardcodes `version = "dev"` and only
#     goreleaser stamps a real version at release time, so every local `go build` reports the
#     same string — a version check would miss exactly the unreleased rebuilds the
#     ~/.local/bin pin below exists to serve.
#
# inode:size:mtime also catches what a plain `-nt` test cannot: a binary whose mtime moves
# *backwards* (a brew downgrade, a bottle or tarball preserving upstream mtimes, restoring an
# older build) would otherwise leave a stale init.zsh in place silently.
_deja_load() {
    local bin="$1"
    local init="${HOME}/.local/share/deja/init.zsh"
    local stamp="${HOME}/.zsh/cache/deja-init.id"
    local id="" cached=""

    zmodload -F zsh/stat b:zstat 2>/dev/null
    if (( $+builtins[zstat] )); then
        local -A st
        zstat -H st "$bin" 2>/dev/null && id="${st[inode]}:${st[size]}:${st[mtime]}"
    fi
    [[ -r "$stamp" ]] && read -r cached < "$stamp"

    # An empty $id means zstat is unavailable and the cache cannot be validated, so it is
    # never trusted — the fingerprints can't compare equal. Slow but always correct.
    if [[ -s "$init" && -n "$id" && "$id" == "$cached" ]]; then
        source "$init"
        return
    fi

    # Miss: let deja rewrite init.zsh, then record which binary produced it. env's async block
    # purges ~/.zsh/cache entries older than 24h and this stamp is only rewritten when the
    # binary changes, so expect one extra regeneration per day — cheap, and a periodic
    # self-heal for a cache that drifted some other way.
    eval "$("$bin" init zsh)"
    if [[ -n "$id" ]]; then
        [[ -d "${stamp:h}" ]] || mkdir -p "${stamp:h}"
        print -r -- "$id" > "$stamp"
    fi
}

_deja_bin="${HOME}/.local/bin/deja"
if [[ -x "$_deja_bin" ]]; then
    DEJA_CYCLE_KEY='\033[Z'
    DEJA_TOGGLE_KEY=''
    _deja_load "$_deja_bin"
fi
unset _deja_bin
unfunction _deja_load
zinit ice pick"/dev/null" atload'ZSH_JUMP_TARGET_STYLE="fg=blue,bold,underline"; fpath+=(${ZINIT[PLUGINS_DIR]}/scfrazer---zsh-jump-target/functions); autoload -Uz jump-target; zle -N jump-target; bindkey "^F" jump-target'
zinit light scfrazer/zsh-jump-target

# dircolors-solarized. Translating the palette file into LS_COLORS costs ~5ms of every
# startup for a result that only changes when the palette does, so cache it. ~/.zsh/cache is
# the directory _cache_completion (~/.zsh/function) already uses; env's async block purges
# entries older than 24h, so this refreshes itself daily on top of the -nt check.
_dircolors_cached() {
    local src="$1"
    local cache="${HOME}/.zsh/cache/dircolors.zsh"
    local dc={{ if eq .chezmoi.os "darwin" }}gdircolors{{ else }}dircolors{{ end }}

    [[ -d "${cache:h}" ]] || mkdir -p "${cache:h}"
    if [[ ! -s "$cache" || "$src" -nt "$cache" ]]; then
        $dc "$src" > "$cache" 2>/dev/null
    fi
    source "$cache"
}
zinit ice as"null" atload'_dircolors_cached ${ZINIT[PLUGINS_DIR]}/seebi---dircolors-solarized/dircolors.256dark'
zinit light seebi/dircolors-solarized

if [[ "$1" == "update" ]]; then
    zinit self-update
    zinit update --all
fi
