{{ if eq .chezmoi.os "darwin" -}}
# ~/.zprofile runs for ALL login shells, interactive or not — unlike ~/.zsh/* (sourced by
# ~/.zshrc), which dot_zshrc's `[[ $- != *i* ]] && return` guard skips for non-interactive
# shells (GUI apps resolving PATH, editor shell-integration probes, `ssh host cmd`). Anything
# that must be on PATH universally belongs here, not in ~/.zsh/*.
#
# chezmoi fully owns this file's content: if something else (pyenv, a future installer, etc.)
# ever needs to append here, that content will be silently dropped on the next `chezmoi
# apply` unless folded into this template.
#
# Everything below is the static expansion of `brew shellenv` plus the GNU-coreutils
# prepends. `brew shellenv` is deliberately NOT called: it costs ~55ms of a ~210ms shell
# startup, because it spawns `brew` (a bash script) which in turn re-evals `path_helper` — and
# this file runs for every login shell, including one per tmux pane. The expansion is static
# on a given machine: `/opt/homebrew/etc/paths` holds exactly `bin` and `sbin`, and there is
# no `/opt/homebrew/etc/paths.d`. Re-check that if the Homebrew prefix layout ever changes.
#
# #90 originally chose `brew shellenv` because its prefix-scoped `path_helper` re-run kept
# nested login shells deduped. The move-to-front prepends below do that job directly, and do
# it more thoroughly: path_helper only rebuilt PATH, so three levels of nesting still produced
# a doubled coreutils `gnubin`, a doubled `gnuman`, and an INFOPATH carrying
# `/opt/homebrew/share/info` once per level. Removing each entry before re-prepending it makes
# re-entry a no-op at any depth.

export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"

# PATH: Homebrew's bin/sbin, with GNU coreutils' gnubin ahead of both, so the unprefixed GNU
# names (date, ls, ...) win over macOS's BSD versions on /usr/bin.
#
# Each entry is *moved* to the front — removed, then prepended — rather than added only when
# absent. /etc/zprofile runs path_helper for every login shell, and that rebuilds PATH from
# /etc/paths, shunting inherited entries to the back. So in a nested login shell (tmux's
# default-command spawns one per pane) a mere "already present?" check would leave /usr/bin
# shadowing Homebrew's git, openssl and ruby — the exact bug #90 set out to fix. Removing
# before prepending is also what keeps nesting from accumulating duplicates, which the old
# `brew shellenv` path_helper re-run never managed for gnubin.
path=(
    /opt/homebrew/opt/coreutils/libexec/gnubin
    /opt/homebrew/bin
    /opt/homebrew/sbin
    ${path:#(/opt/homebrew/opt/coreutils/libexec/gnubin|/opt/homebrew/bin|/opt/homebrew/sbin)}
)
export PATH

# Same move-to-front treatment for the two colon-separated string variables. Keeping the
# `$entry:$rest` shape means that when $rest is empty the value ends in a colon — the trailing
# empty entry that tells man(1)/info(1) to search their built-in defaults too, which both
# `brew shellenv` and the previous coreutils line relied on.
_zprofile_prepend() {
    local var=$1 entry=$2
    local -a parts=("${(@s.:.)${(P)var}}")
    typeset -gx "$var=$entry:${(j.:.)${(@)parts:#$entry}}"
}
_zprofile_prepend MANPATH /opt/homebrew/opt/coreutils/libexec/gnuman
_zprofile_prepend INFOPATH /opt/homebrew/share/info
unset -f _zprofile_prepend

# fpath is already an array, so it needs no splitting. Exported as FPATH to match
# `brew shellenv`, so non-zsh consumers still see it.
fpath=(
    /opt/homebrew/share/zsh/site-functions
    ${fpath:#/opt/homebrew/share/zsh/site-functions}
)
export FPATH
{{ end -}}
