#!/usr/bin/env bash
# Install base packages for the detected OS. Replaces the old setup/{darwin,debian}
# scripts. Plugin managers (zinit/tpm/gitstatus) are handled by
# .chezmoiexternal, not here.
#
# run_BEFORE_ on purpose: base tooling must exist before any config file/template
# renders, because chezmoi executes run_before_ scripts before it renders + writes
# files. In particular ~/.config/git/config gates the gh credential helper on
# `lookPath "gh"` (dot_config/git/config.tmpl) — installing gh here makes that
# true on the FIRST apply, so a single `chezmoi apply` converges (no drift needing
# a second pass). Do not "fix" this back to run_once_after_.
#
# run_once_ semantics: chezmoi re-runs this whenever the *rendered* content hash
# changes — so editing this script re-triggers installs. On Debian a re-run does
# NOT rebuild Neovim: the `command -v nvim` guard below short-circuits once nvim
# exists. Keep it stable regardless.
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# ===== macOS / Homebrew =====
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found — install it from https://brew.sh and re-run 'chezmoi apply'." >&2
    exit 1
fi
brew install git gh zsh tmux neovim atool gsed coreutils
brew install romkatv/gitstatus/gitstatus
# Window management (all macs). After install, start them once with
# `yabai --start-service` and `skhd --start-service`; some yabai features also
# require SIP to be partially disabled (manual, out of scope here).
brew install asmvik/formulae/yabai asmvik/formulae/skhd
# deja: predictive shell autosuggestions, as a prebuilt binary. Deliberately not --HEAD:
# that path pulls in brew's `go` and builds from source. conflicts_with
# giammarco-ferranti/deja/deja, which must be uninstalled first or this aborts the script.
brew install serubin/tools/deja-canary

{{ else if eq .chezmoi.os "linux" -}}
{{   $id := .chezmoi.osRelease.id -}}
{{   if or (eq $id "debian") (eq $id "ubuntu") -}}
# ===== Debian / Ubuntu =====
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update
sudo apt-get install -y git zsh tmux atool curl ca-certificates

build_neovim() {
    sudo apt-get install -y ninja-build gettext cmake curl build-essential git
    local latest
    latest=$(curl -sL https://api.github.com/repos/neovim/neovim/tags \
        | grep -m1 '"name":' | sed -E 's/.*"name": *"([^"]+)".*/\1/')
    echo "Building Neovim ${latest} from source..."
    rm -rf /tmp/neovim
    git clone --depth 1 --branch "$latest" https://github.com/neovim/neovim /tmp/neovim
    ( cd /tmp/neovim && make CMAKE_BUILD_TYPE=RelWithDebInfo && sudo make install )
    rm -rf /tmp/neovim
}

# Prefer Homebrew's neovim if brew is present (newer than apt); else build from
# source only when nvim is missing.
if command -v brew >/dev/null 2>&1; then
    brew install neovim
elif ! command -v nvim >/dev/null 2>&1; then
    build_neovim
fi

# Register nvim as the system vi/vim/editor (non-interactive; the old script used
# the blocking `--config` form, which we drop).
if command -v nvim >/dev/null 2>&1; then
    nvim_path=$(command -v nvim)
    for alt in vi vim editor; do
        sudo update-alternatives --install "/usr/bin/$alt" "$alt" "$nvim_path" 60
    done
fi

# GitHub CLI (gh): backs the git credential helper. Not in Debian's default
# repos, so prefer Homebrew if present, else add GitHub's signed apt repo.
if command -v gh >/dev/null 2>&1; then
    :  # already installed
elif command -v brew >/dev/null 2>&1; then
    brew install gh
else
    sudo mkdir -p -m 755 /etc/apt/keyrings
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
    sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
    sudo apt-get update
    sudo apt-get install -y gh
fi

# deja: no apt package, so brew when available (see the guard below), else install_deja --
# upstream's checksum-verified release tarball into ~/.local/bin, which keeps brew-less boxes
# working. The fallback gets upstream deja, not the canary.
#
# Not upstream's install.sh: it appends `eval "$(deja init zsh)"` to ~/.zshrc (chezmoi owns
# that) and imports from deja's default histfile rather than ours.
#
# Either binary is glibc-linked (CGO sqlite driver), so fine on Debian, not on musl.
#
# On work-devbox the brew prefix does not survive a host restart, so ~/personalize reinstalls
# deja every boot; this script only covers the first apply.
install_deja() {
    local arch tag version archive base tmp
    case "$(uname -m)" in
        x86_64|amd64)  arch=amd64 ;;
        aarch64|arm64) arch=arm64 ;;
        *) echo "deja: no prebuilt binary for $(uname -m) — skipping." >&2; return 0 ;;
    esac
    tag=$(curl -fsSL https://api.github.com/repos/Giammarco-Ferranti/deja/releases/latest \
        | grep -m1 '"tag_name":' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/')
    [ -n "$tag" ] || { echo "deja: could not resolve latest release tag" >&2; return 1; }
    version=${tag#v}
    archive="deja_${version}_linux_${arch}.tar.gz"
    base="https://github.com/Giammarco-Ferranti/deja/releases/download/${tag}"
    tmp=$(mktemp -d) || return 1
    # Every step below is checked EXPLICITLY rather than leaning on `set -e`: this
    # function is called in an `install_deja || ...` list, and bash suspends -e for
    # the whole body of a function invoked that way. An unchecked failure would fall
    # through to the next step — e.g. a failed checksum would still reach `install`.
    if ! curl -fsSL -o "$tmp/$archive" "$base/$archive" ||
        ! curl -fsSL -o "$tmp/checksums.txt" "$base/checksums.txt"; then
        echo "deja: download failed ($base/$archive)" >&2
        rm -rf "$tmp"; return 1
    fi
    # Same-origin digest: catches a truncated or mangled download, NOT a compromised
    # release (whoever can rewrite the tarball can rewrite checksums.txt). It fails
    # closed either way — a mismatch, or a checksums.txt with no line for our
    # archive (empty grep => "no properly formatted checksum lines"), installs
    # nothing.
    if ! ( cd "$tmp" && grep " ${archive}\$" checksums.txt | sha256sum -c - >/dev/null ); then
        echo "deja: checksum verification FAILED for $archive — not installing." >&2
        rm -rf "$tmp"; return 1
    fi
    if ! tar -xzf "$tmp/$archive" -C "$tmp" deja; then
        echo "deja: $archive did not contain a deja binary" >&2
        rm -rf "$tmp"; return 1
    fi
    # ~/.local/bin, not /usr/local/bin: no sudo needed and dot_zshenv already puts
    # it on PATH for every zsh invocation.
    if ! mkdir -p "$HOME/.local/bin" || ! install -m 0755 "$tmp/deja" "$HOME/.local/bin/deja"; then
        echo "deja: could not install into $HOME/.local/bin" >&2
        rm -rf "$tmp"; return 1
    fi
    rm -rf "$tmp"
    echo "Installed deja ${version} to $HOME/.local/bin/deja"
}

# dot_zshenv's ~/.local/bin PATH entry only applies to zsh, so add it here for the
# guard below and for the history import at the end of this script.
export PATH="$HOME/.local/bin:$PATH"
# Absolute path, because /etc/profile.d/homebrew.sh puts only <prefix>/Homebrew/bin on
# PATH and that copy of brew reports its own directory as HOMEBREW_PREFIX -- a bare
# `brew install` would then split the Cellar in two.
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    brew_bin=/home/linuxbrew/.linuxbrew/bin/brew
else
    brew_bin=$(command -v brew 2>/dev/null || true)
fi

if ! command -v deja >/dev/null 2>&1; then
    # Non-fatal on purpose, both paths: this is a run_before_ script, so letting a GitHub
    # outage or a failed download abort it would abort the whole apply over a nice-to-have.
    # Explicit `|| echo` rather than relying on set -e, for the same reason install_deja
    # checks every step itself.
    if [ -n "$brew_bin" ]; then
        "$brew_bin" install serubin/tools/deja-canary ||
            echo "deja: 'brew install serubin/tools/deja-canary' failed — suggestions stay inert; re-run 'chezmoi apply' to retry." >&2
    else
        install_deja || echo "deja: install failed — suggestions stay inert; re-run 'chezmoi apply' to retry." >&2
    fi
fi
{{   else -}}
echo "Unsupported Linux distro: '{{ $id }}'. Install git zsh tmux atool neovim deja manually." >&2
{{   end -}}
{{ end -}}

# One-time seed of deja's DB from our history. `deja import` is NOT idempotent
# (it inserts rows blindly), so run it only when the DB doesn't exist yet. Our
# HISTFILE is ~/.config/.histfile (see dot_zsh/env.tmpl) — NOT deja's default — so
# point it there explicitly. Best-effort; never fail the apply.
if command -v deja >/dev/null 2>&1 && [ ! -f "$HOME/.local/share/deja/deja.db" ]; then
    deja import --file "$HOME/.config/.histfile" || true
fi
