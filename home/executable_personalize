#!/usr/bin/env bash
# Work-devbox startup bootstrap, run at boot to reconverge state that does NOT survive
# a host restart: the dotfiles themselves (via chezmoi), the sshd keepalive drop-in in
# /etc, and the tmux-save cron. Persistent $HOME files are chezmoi's job and are not
# regenerated here. Deliberately not `set -e`: one failing step must not skip the rest.

#pip install pynvim

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# --- Dotfiles: install chezmoi if missing + apply, by running this repo's install.sh
# from the persisted local checkout, so there is no network or branch dependency.
# install.sh also runs the base-package chezmoiscript and deploys the helper scripts
# this bootstrap calls below.
DOTFILES_SRC="${DOTFILES_SRC:-$HOME/.dotfiles}"
if [ -x "$DOTFILES_SRC/install.sh" ]; then
    "$DOTFILES_SRC/install.sh" --env work --class work-devbox
else
    echo "[personalize] chezmoi source not found at $DOTFILES_SRC;" \
         "onboard first by running this repo's install.sh." >&2
fi

# --- Work-devbox packages. Nothing outside /home/coder survives a host restart, so every
# package not baked into the base image is (re)installed here each run; chezmoi's run_once
# does not apply.
brew install \
    ejoffe/tap/spr \
    serubin/tools/deja-canary \
    claude-code@latest \
    mosh \
    inotify-tools \
    googleworkspace-cli \
    jj \
    glow

# --- Reset VSCode settings for the lwcode workspace (background; work-specific).
nohup /home/coder/lwcode/reset-vscode-settings.sh > /tmp/startup-vscode-settings.log 2>&1 &

# --- SSH keepalive drop-in in /etc (root-owned, wiped on restart -> re-applied
# here, not by chezmoi). Generation lives in its own chezmoi-managed script.
"$HOME/.local/bin/apply-sshd-keepalive.sh"

# --- Re-optimize the image's /etc/zsh (root-owned, also wiped on restart). Backgrounded:
# personalize is the Coder startup script, so a slow or hung step here delays workspace
# readiness and surfaces as "agent failed to connect". Nothing downstream needs this, so
# it must never gate startup; a pane opening before it finishes just pays full price
# once (it already raced the first shell even when synchronous).
nohup "$HOME/.local/bin/apply-etc-zsh-perf.sh" > /tmp/startup-apply-etc-zsh-perf.log 2>&1 &

# --- Periodic tmux-resurrect save cron (every 5 min). The crontab does not survive a
# host restart, so it is (re)installed here rather than at chezmoi apply; the script
# itself is chezmoi-managed. Idempotent: de-duped by the marker comment, other entries
# preserved.
if command -v crontab >/dev/null 2>&1; then
    line="*/5 * * * * $HOME/.local/bin/tmux-periodic-save.sh >/dev/null 2>&1 # tmux-periodic-save"
    ( crontab -l 2>/dev/null | grep -vF '# tmux-periodic-save'; echo "$line" ) | crontab -
fi

# --- Coder keep-alive. Holds the workspace autostop deadline out until 6pm ET on
# weekdays so a long meeting or lunch can't reclaim the box mid-day. The helper
# (re)provisions a stable coder binary under ~/.local/state (the PATH one lives in a
# per-SSH-session /tmp dir) and installs its own */15 cron -- both wiped on a host
# restart, so like the tmux cron they are re-established here. It reuses the ambient
# `coder login` session; if that expires it warns via a ~/.zsh startup banner.
if [ -x "$HOME/.local/bin/coder-keepalive.sh" ]; then
    "$HOME/.local/bin/coder-keepalive.sh" install || true
fi
