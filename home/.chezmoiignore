# Paths chezmoi must never manage (matched against target paths under $HOME).
#
# IMPORTANT: do NOT list external targets (.zsh/zinit, .zsh/gitstatus,
# .tmux/plugins) here. .chezmoiignore removes entries from the target state,
# .chezmoiexternal entries included — ignoring one silently skips its clone.

# zsh runtime / compiled caches
.zsh/cache
*.zwc
.zcompdump*

# nvim runtime: shell history + lazy.nvim lock/state (unpinned, like today)
.config/.histfile
.config/nvim/lazy-lock.json
.config/nvim/lazyvim.json
.config/nvim/lazy

# Claude Code: only the curated config (settings.json, CLAUDE.md, skills/,
# plugins/blocklist.json) is managed; guard secrets and the cloned marketplace repos.
#
# Three dirs, because Claude Code keys its whole identity off CLAUDE_CONFIG_DIR:
# ~/.claude is the one store -- assets AND session state -- and
# ~/.claude-{personal,work} hold one login each, symlinking back to it for
# everything but .claude.json, credentials and the org-pushed policy files.
#
# Only ~/.claude's copies are listed here. The account dirs' settings.json and
# settings.local.json are chezmoi-managed SYMLINKS into ~/.claude, so ignoring
# them would suppress the link rather than protect anything.
#
# settings.json is merged, not overwritten (Claude Code owns the keys it toggles)
# -- see .chezmoitemplates/claude-settings-merge.py.
#
# settings.local.json is listed defensively: Claude Code reads it at PROJECT scope
# only, so a user-scope copy would never be consumed anyway.
#
# known_marketplaces.json is listed rather than deleted from the source because
# Claude Code rewrites it in place and `chezmoi add`/`re-add` would pull it back:
# per-machine clone paths and a `lastUpdated` stamp are state, not config.
.claude/settings.local.json
.claude/.credentials.json
.claude/plugins/marketplaces
.claude/plugins/known_marketplaces.json
.claude-personal/.credentials.json
.claude-personal/plugins/marketplaces
.claude-personal/plugins/known_marketplaces.json
.claude-work/.credentials.json
.claude-work/plugins/marketplaces
.claude-work/plugins/known_marketplaces.json

# Repo docs kept next to the config they document, but NOT deployed to $HOME.
# (.zsh/README.md would otherwise be sourced by .zshrc's `~/.zsh/*` loop.)
.zsh/README.md
.config/nvim/README.md

# ----- machine-class gating (see README "Machine targeting" + feature matrix) -----
# Gate by OS (.chezmoi.os), environment (.environment), or class (.class); patterns
# match TARGET paths. NOTE: never glob a path that would swallow a .chezmoiexternal
# target (.zsh/zinit, .zsh/gitstatus, .tmux/plugins/tpm) — that suppresses its clone.

# yabai + skhd are macOS window-manager configs — keep on ANY mac, skip elsewhere.
{{ if ne .chezmoi.os "darwin" }}
.config/yabai
.config/skhd
{{ end }}

# Class-specific example scripts (replace with your own). A custom class (e.g.
# homelab) matches neither, so both are ignored — add your own class gate for it.
{{ if ne .class "work-mac" }}
.local/bin/example-work-mac
{{ end }}
{{ if ne .class "work-devbox" }}
.local/bin/example-work-devbox
{{ end }}

# work-devbox bootstrap + helpers: the ~/personalize startup script, the two /etc
# re-apply helpers it calls (sshd keepalive, /etc/zsh startup cost), the tmux -CC
# (iTerm2 control-mode) helpers (periodic-save cron target + stale-client-clearing
# connect helper), and the /mnt/cache EBS build-cache mount plus the gate the connect
# helper calls to run it. The mac side of this workflow is the sleepwatcher feature below.
{{ if ne .class "work-devbox" }}
personalize
.local/bin/apply-sshd-keepalive.sh
.local/bin/apply-etc-zsh-perf.sh
.local/bin/tmux-periodic-save.sh
.local/bin/tmux-devel.sh
.local/bin/coder-keepalive.sh
.local/bin/mount-cache-dir
.local/bin/ensure-cache-mount.sh
{{ end }}

# sleepwatcher sleep/wake feature (Coder iTerm2/tmux + fwd hygiene): work-mac only.
{{ if ne .class "work-mac" }}
.config/sleepwatcher
Library/LaunchAgents/net.serubin.sleepwatcher.plist
{{ end }}
