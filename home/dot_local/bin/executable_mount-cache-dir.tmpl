#!/usr/bin/env bash
# Attach + mount the EBS build-cache volume at /mnt/cache. Nothing outside
# /home/coder survives a workspace host restart, so it must be re-attached and
# re-mounted after every one. Run by hand any time, or let
# ~/.local/bin/ensure-cache-mount.sh call it once per SSH connection.
#
# The volume id and AWS account id come from chezmoi [data] rather than being
# hardcoded: this repo is public and both are work infrastructure identifiers.
# Set them with `chezmoi init` (or DOTFILES_CACHE_VOLUME_ID / DOTFILES_AWS_ACCOUNT_ID).
#
# Managed by chezmoi (source: home/dot_local/bin/executable_mount-cache-dir.tmpl),
# work-devbox only.

{{/* hasKey guards: a bare .cacheVolumeID would hard-error `chezmoi apply` on a
     machine whose config predates these keys (a missing key errors before any
     `default` pipe can apply). Empty renders are caught at runtime just below. */ -}}
VOLUME_ID={{ if hasKey . "cacheVolumeID" }}{{ .cacheVolumeID | quote }}{{ else }}""{{ end }}
AWS_ACCOUNT_ID={{ if hasKey . "awsAccountID" }}{{ .awsAccountID | quote }}{{ else }}""{{ end }}

cachedir_dev="/dev/sdj"

if [[ -z "$VOLUME_ID" ]]; then
  echo "no EBS volume id configured for /mnt/cache"
  echo "set it with: chezmoi init   (prompts for 'EBS volume id for /mnt/cache')"
  exit 1
fi

TOKEN=$(curl -fsSL -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")

aws_mount_volume() {
  if ! AWS_REGION=$(curl -fsSL -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region) ; then
    echo "Couldn't get aws region"
    exit 1
  fi
  export AWS_REGION

  aws ec2 attach-volume \
      --volume-id "$VOLUME_ID" \
      --instance-id "$INSTANCE_ID" \
      --device "$cachedir_dev"
}

# Refresh SSO creds, then re-authenticate pip against CodeArtifact. Kept as two
# independent checks: only the SSO login gates attach-volume, so a codeartifact
# failure must not abort the mount (and must not be misreported as an SSO failure).
aws_login() {
  if ! aws sso login ; then
    echo "couldn't aws sso login"
    return 1
  fi

  if [[ -n "$AWS_ACCOUNT_ID" ]]; then
    aws codeartifact login --profile devtest-power --tool pip --repository dpe-python \
        --domain lacework --domain-owner "$AWS_ACCOUNT_ID" --region us-west-2 \
      || echo "warning: codeartifact login failed; pip may not resolve internal packages"
  else
    echo "warning: no AWS account id configured; skipping codeartifact login"
  fi
}

if [[ ! -b "$cachedir_dev" ]]; then
  echo "cachedir device does not exist $cachedir_dev"
  INSTANCE_ID=$(curl -fsSL -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
  if [[ -z "$INSTANCE_ID" ]]; then
      echo "unable to get instance id"
      exit 1
  fi
  echo "attaching ebs volume to $cachedir_dev"

  if ! aws_mount_volume ; then
    aws_login || exit 1
    aws_mount_volume
  fi

  echo -n "waiting for $cachedir_dev to exist "
  while [[ ! -b "$cachedir_dev" ]]; do
    sleep 1
    echo -n "."
  done
  echo
fi

# This volume holds only regenerable build caches (mbx, bazel), so reformatting it costs
# nothing but a repopulate. btrfs is deliberate: mbx restores cached outputs into target
# directories by cloning, which needs a CoW filesystem, and zstd roughly quarters what
# build artifacts occupy. On ext4 neither worked -- every restore was a full copy.
#
# lsblk rather than blkid: blkid exits 2 on an unformatted device and can exit 0 while
# printing nothing on a partitioned one, conflating "unformatted" with "unreadable".
cachedir_fstype=$(lsblk -no FSTYPE "$cachedir_dev" | head -1 | tr -d '[:space:]')
cachedir_opts="defaults,noatime,compress=zstd:3,nofail"
if [[ $cachedir_fstype != btrfs ]]; then
  echo "$cachedir_dev is ${cachedir_fstype:-unformatted}, reformatting as btrfs (discards the build caches)"
  if mountpoint -q /mnt/cache && ! sudo umount /mnt/cache ; then
    echo "couldn't unmount /mnt/cache; close anything using it and re-run"
    exit 1
  fi
  # fstab is rewritten only on success: a btrfs line over a failed mkfs wedges every
  # later `mount -a`, at boot included.
  if ! sudo mkfs.btrfs -f -L cache "$cachedir_dev" ; then
    echo "mkfs.btrfs failed on $cachedir_dev; leaving /etc/fstab alone"
    exit 1
  fi
  echo "Initialized btrfs filesystem on $cachedir_dev"
fi

# Rewrite in place when a line exists (an earlier run of this script wrote an ext4 one),
# append when it does not -- /etc does not survive a host restart.
if grep -q ' /mnt/cache ' /etc/fstab ; then
  sudo sed -i "s| /mnt/cache .*$| /mnt/cache btrfs $cachedir_opts 0 0|" /etc/fstab
else
  echo "$cachedir_dev /mnt/cache btrfs $cachedir_opts 0 0" | sudo tee -a /etc/fstab >/dev/null
fi

sudo mkdir -p /mnt/cache
sudo mount -a

sudo chown coder:coder /mnt/cache

# spark-cli's SPARK_LOCAL_DIRECTORY, wiped by a reformat and created by nothing else.
mkdir -p /mnt/cache/lhq-spark

"$HOME/.local/bin/clear-bazel-cache.sh"

echo
df -h | rg 'cache|coder|Use%'
